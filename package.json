{
	"name": "quakec-modern",
	"displayName": "QuakeC Modern",
	"description": "QuakeC IntelliSense, diagnostics, and code browsing, with support for gmqcc and FTEQCC language extensions.",
	"author": "Llortus",
	"contributors": [
		"Joshua Skelton (https://github.com/joshuaskelly)"
	],
	"license": "MIT",
	"version": "0.3.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/llortus/vscode-quakec-modern"
	},
	"bugs": {
		"url": "https://github.com/llortus/vscode-quakec-modern/issues"
	},
	"homepage": "https://github.com/llortus/vscode-quakec-modern#readme",
	"publisher": "Llortus",
	"categories": [
		"Programming Languages",
		"Linters"
	],
	"icon": "images/icon.png",
	"keywords": [
		"quake",
		"quakec",
		"qc",
		"gmqcc",
		"fteqcc",
		"idtech"
	],
	"engines": {
		"node": "*",
		"vscode": "^1.39.0"
	},
	"activationEvents": [
		"onLanguage:quakec"
	],
	"main": "./client/src/extension.js",
	"contributes": {
		"languages": [
			{
				"id": "quakec",
				"aliases": [
					"QuakeC",
					"Quake-C",
					"qcc"
				],
				"configuration": "./client/language-configuration.json",
				"extensions": [
					".qc",
					".qh"
				]
			}
		],
		"grammars": [
			{
				"language": "quakec",
				"scopeName": "source.qc",
				"path": "./client/syntaxes/quakec.tmLanguage.json"
			}
		],
		"configuration": {
			"type": "object",
			"title": "QuakeC Extension Configuration",
			"properties": {
				"quakec.language": {
					"scope": "resource",
					"type": "string",
					"enum": [
						"gmqcc",
						"fteqcc",
						"qcc"
					],
					"enumDescriptions": [
						"gmqcc's default standard (-std=gmqcc): const, C-style functions, for/switch, typedef, enum, arrays, attributes, and more.",
						"gmqcc with -std=fteqcc: the same syntax, with FTEQCC's predefined macros.",
						"gmqcc with -std=qcc: original QuakeC. Reports C-style functions and newer operators."
					],
					"default": "gmqcc",
					"markdownDescription": "The QuakeC standard to check code against. Matches the `-std` option of gmqcc."
				}
			}
		}
	},
	"scripts": {
		"postinstall": "cd client && npm install && cd ../server && npm install && cd ../parser && npm install && cd ..",
		"test": "npm run test:unit && npm run test:integration",
		"test:unit": "mocha \"*/test/**/*.js\"",
		"test:integration": "node ./server/src/test/runTests.js",
		"package": "vsce package",
		"deploy": "vsce publish"
	},
	"devDependencies": {
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "^4.1.0",
		"glob": "^7.2.3",
		"mocha": "^8.4.0"
	}
}
